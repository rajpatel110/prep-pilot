{
  "name": "prep-pilot",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:integration": "node --env-file=.env.local --import tsx tests/auth-integration.ts",
    "test:email": "node --conditions=react-server --env-file=.env.local --import tsx tests/email-integration.ts",
    "test:brevo": "node --conditions=react-server --env-file=.env.local --import tsx tests/brevo-integration.ts",
    "test:brevo-http": "node --conditions=react-server --env-file=.env.local --import tsx tests/brevo-http.ts",
    "test:email-auth": "node --conditions=react-server --env-file=.env.local --import tsx tests/email-auth-regressions.ts",
    "test:files": "node --conditions=react-server --env-file=.env.local --import tsx tests/files-integration.ts",
    "files:accounting": "node --env-file=.env.local --import tsx scripts/files-accounting.ts",
    "test:catalog": "node --conditions=react-server --env-file=.env.local --import tsx tests/catalog-integration.ts",
    "test:admin-content": "node --conditions=react-server --env-file=.env.local --import tsx tests/integration/admin-content.ts",
    "test:student": "node --conditions=react-server --env-file=.env.local --import tsx tests/integration/student-journey.ts",
    "test:practice": "node --conditions=react-server --env-file=.env.local --import tsx tests/integration/student-journey.ts --practice",
    "test:planning": "node --conditions=react-server --env-file=.env.local --import tsx tests/integration/student-journey.ts --planning",
    "auth:setup": "tsx scripts/setup-local-auth.ts",
    "db:setup": "node --env-file=.env.local --import tsx scripts/setup-database.ts",
    "admin:provision": "node --conditions=react-server --env-file=.env.local --import tsx scripts/provision-admin.ts",
    "admin:owner": "node --conditions=react-server --env-file=.env.local --import tsx scripts/provision-owner.ts",
    "test:administration": "node --conditions=react-server --env-file=.env.local --import tsx tests/administration-integration.ts",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier . --check",
    "format": "prettier . --write"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@better-auth/mongo-adapter": "1.7.12",
    "better-auth": "1.7.12",
    "mongodb": "7.7.0",
    "mongoose": "9.11.3",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
